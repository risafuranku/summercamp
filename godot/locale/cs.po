#: scripts/os98/apps/browser_app.gd:1454
msgid "is anyone from Hlubocany. need a lift saturday"
msgstr "je tu někdo z Hlubočan. potřebuju v sobotu svézt"

#: scripts/os98/apps/browser_app.gd:1455
msgid "goodnight all, the film is on"
msgstr "dobrou všichni, začíná film"

#: scripts/os98/apps/browser_app.gd:1456
msgid "Sparta lost. I am going to bed"
msgstr "Sparta prohrála. jdu spát"

#: scripts/os98/apps/browser_app.gd:1457
msgid "anyone still up"
msgstr "je ještě někdo vzhůru"

#: scripts/os98/apps/browser_app.gd:1460
