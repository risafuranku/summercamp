#. uses 2
msgid "Antlers"
msgstr "Parohy"

#: scripts/pub/pub_layout.gd:215
msgid "A six-pointer. Shot by the landlord's father, or bought at the market in Pisek: it depends who tells it."
msgstr "Šesterák. Střelil ho hostinského táta, nebo ho koupil na trhu v Písku: záleží, kdo to vypráví."

#: scripts/pub/pub_layout.gd:216
msgid "Boar"
msgstr "Kanec"

#: scripts/pub/pub_layout.gd:217
msgid "Somebody has dusted the boar lately. Round the eyes."
msgstr "Kance někdo nedávno oprášil. Kolem očí."

#: scripts/pub/pub_layout.gd:226
msgid "The car park, the lamp, the forest. The lamp flickers when somebody walks under it. Nobody is."
msgstr "Parkoviště, lampa, les. Lampa zabliká, když pod ní někdo jde. Nikdo tam nejde."

#: scripts/pub/pub_layout.gd:229
msgid "DLUZNICI, who owes for beer. The top name is rubbed out every morning and is back every night."
msgstr "DLUŽNÍCI, kdo dluží za pivo. Horní jméno se každé ráno smaže a každý večer je tam zas."

#: scripts/pub/pub_layout.gd:231
msgid "Cerne jezero, 1978. More people on the beach than live in the whole district now."
msgstr "Černé jezero, 1978. Na pláži víc lidí, než dnes žije v celém okrese."

#: scripts/pub/pub_layout.gd:236
msgid "The kamna. Cold since spring. There is warm ash in it."
msgstr "Kamna. Od jara studená. Je v nich teplý popel."

#: scripts/pub/pub_layout.gd:238
msgid "Coal for the winter. A child's shoe on top of it."
msgstr "Uhlí na zimu. Navrchu dětská bota."

#: scripts/pub/pub_layout.gd:240
msgid "A green loden coat, wet through. It has not rained today."
msgstr "Zelený lodenový kabát, promočený skrz naskrz. Dnes nepršelo."

#: scripts/pub/pub_layout.gd:242
msgid "Full. Somebody has hung a new one beside it, and that is filling up too."
msgstr "Plná. Někdo vedle pověsil novou a i ta se plní."

#: scripts/pub/pub_layout.gd:243
msgid ""
"HOSPODA\n"
"the pub"
msgstr "HOSPODA"

