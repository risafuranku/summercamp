#: scripts/quest_manager.gd:44
msgid "Walk up to it and hold R."
msgstr "Dojdi k ní a drž R."

#: scripts/quest_manager.gd:50
msgid "Clean out the old cabin and make up the bed."
msgstr "Ukliď starou chatku a ustel postel."

#: scripts/quest_manager.gd:51
msgid "Inside, hold the mouse on what needs doing."
msgstr "Uvnitř drž myš na tom, co je potřeba udělat."

#: scripts/quest_manager.gd:57
msgid "Install Builder 98 and GuestRack from the links in Vera's mail."
msgstr "Nainstaluj Builder 98 a GuestRack z odkazů ve Věřině mailu."

#: scripts/quest_manager.gd:58
msgid "Click a link, then run the file from the Download folder."
msgstr "Klikni na odkaz a pak spusť soubor ze složky Download."

#: scripts/quest_manager.gd:63
msgid "Bulldoze some trees and put up a tent or another cabin."
msgstr "Vyklučuj buldozerem pár stromů a postav stan nebo další chatku."

#: scripts/quest_manager.gd:64
msgid "Builder: bulldozer, then Housing."
msgstr "Builder: buldozer, pak Ubytování."

#: scripts/quest_manager.gd:69
msgid "Guests need a toilet. Build a Toilet Block near the beds."
msgstr "Hosté potřebují záchod. Postav blízko postelí záchody."

#: scripts/quest_manager.gd:70
msgid "Builder: Services > Toilet. It needs the sewer by the lake."
msgstr "Builder: Služby > Záchody. Potřebují kanalizaci u jezera."

#: scripts/quest_manager.gd:75
msgid "A booking just arrived. Open CampMail and ACCEPT it."
msgstr "Právě přišla rezervace. Otevři CampMail a PŘIJMI ji."

#: scripts/quest_manager.gd:76
msgid "Check the NIGHT RISK line before you accept."
msgstr "Než přijmeš, podívej se na řádek NOČNÍ RIZIKO."

#: scripts/quest_manager.gd:82
msgid "Mirek reaches reception in about an hour. Make sure his room is made up."
msgstr "Mirek dorazí na recepci asi za hodinu. Postarej se, ať má nachystaný pokoj."

#: scripts/quest_manager.gd:83
msgid "Esc gets you up from the desk."
msgstr "Esc tě zvedne od stolu."

#: scripts/quest_manager.gd:89
msgid "Mirek is at the counter. Check him in."
msgstr "Mirek je u pultu. Ubytuj ho."

#: scripts/quest_manager.gd:90
msgid "Write him in the register, give him his key, stamp the booking."
msgstr "Zapiš ho do knihy, dej mu klíč, orazítkuj rezervaci."

#: scripts/quest_manager.gd:92
msgid "The book"
msgstr "Kniha"

#: scripts/quest_manager.gd:93
msgid ""
"Everyone who sleeps here goes in the book: name and number off the card, the booking off the slip, the right key off the board, the stamp, the papers back.\n"
"\n"
"If someone comes to the desk who is not booked and his card does not look right, you stamp him REFUSED and give him his card back. Do not argue with him.\n"
"\n"
"- V."
msgstr ""
"Každý, kdo tu spí, jde do knihy: jméno a číslo z průkazu, rezervace z lístku, správný klíč z tabule, razítko, papíry zpátky.\n"
"\n"
"Když k pultu přijde někdo, kdo nemá rezervaci a jehož průkaz nevypadá v pořádku, dáš mu razítko ODMÍTNUTO a vrátíš mu průkaz. Nehádej se s ním.\n"
"\n"
"- V."

#: scripts/quest_manager.gd:97
msgid "Guests get hungry. Build a Bistro or a Pub."
msgstr "Hosté dostanou hlad. Postav bistro nebo hospodu."

#: scripts/quest_manager.gd:98
msgid "Builder: Services. Food needs power."
msgstr "Builder: Služby. Jídlo potřebuje proud."

#: scripts/quest_manager.gd:103
msgid "Nights here are dark. Put up 2 lamp posts."
msgstr "Noci jsou tu tmavé. Postav 2 lampy."

#: scripts/quest_manager.gd:104
msgid "Builder: Lamp. Guests feel safer under light."
msgstr "Builder: Lampa. Pod světlem se hosté cítí bezpečněji."

#: scripts/quest_manager.gd:109
msgid "Night is coming. Get through it until 06:30."
msgstr "Blíží se noc. Vydrž do 06:30."

#: scripts/quest_manager.gd:110
msgid "The bed is behind the office, through the door by the keys."
msgstr "Postel je za kanceláří, dveřmi u klíčů."

#: scripts/quest_manager.gd:112 scripts/os98/apps/campstat_app.gd:833
#. uses 2
msgid "Tonight"
msgstr "Dnes v noci"

#: scripts/quest_manager.gd:113
msgid ""
"When it gets dark the builder locks. That is not a bug, that is the camp.\n"
"\n"
"If you hear footsteps where there is nobody, turn around. If something follows you, get inside. Do not stand in the dark staring at it. The more of one kind of guest you take, the worse the night.\n"
"\n"
"See you in the morning. Please.\n"
"\n"
"- V."
msgstr ""
"Když se setmí, Builder se zamkne. To není chyba, to je kemp.\n"
"\n"
"Když uslyšíš kroky tam, kde nikdo není, otoč se. Když za tebou něco jde, jdi dovnitř. Nestůj ve tmě a nezírej na to. Čím víc hostů jednoho druhu vezmeš, tím horší noc.\n"
"\n"
"Uvidíme se ráno. Prosím.\n"
"\n"
"- V."

#: scripts/quest_manager.gd:117
msgid "The electricity bill arrived. Pay it in CampStat before it is overdue."
msgstr "Přišel účet za elektřinu. Zaplať ho v CampStatu, než bude po splatnosti."

#: scripts/quest_manager.gd:118
msgid "CampStat > Bills."
msgstr "CampStat > Účty."

#: scripts/quest_manager.gd:123
msgid "Earn a 4-star review from a departing guest."
msgstr "Získej od odjíždějícího hosta recenzi za 4 hvězdičky."

#: scripts/quest_manager.gd:124
msgid "Happy guests: food, toilets, showers, fun, a good bed."
msgstr "Spokojení hosté: jídlo, záchody, sprchy, zábava, dobrá postel."

#: scripts/quest_manager.gd:129
msgid "Host 6 guests at the same time."
msgstr "Ubytuj najednou 6 hostů."

#: scripts/quest_manager.gd:130
msgid "More beds. Mix the guest types or the nights get worse."
msgstr "Víc postelí. Míchej druhy hostů, jinak budou noci horší."

#: scripts/quest_manager.gd:292
msgid "TASK COMPLETE"
msgstr "ÚKOL SPLNĚN"

#: scripts/quest_manager.gd:293
msgid "Checklist: %s"
msgstr "Seznam: %s"

#: scripts/quest_manager.gd:306
msgid "Checklist done. Keep the camp open and paying until the inspection (19 October)."
msgstr "Seznam je hotový. Udrž kemp otevřený a v zisku až do inspekce (19. října)."

#: scripts/quest_manager.gd:313
msgid "You did everything on my list"
msgstr "{g:Udělal|Udělala} jsi všechno z mého seznamu"

#: scripts/quest_manager.gd:314
msgid ""
"Every box ticked. I did not expect that, and I mean it kindly.\n"
"\n"
"Now just keep them alive and keep them happy until the man from the district has been. Watch the forecast. Pay the bills. Crawl into the sewer if you must.\n"
"\n"
"- Teta Vera"
msgstr ""
"Všechno odškrtnuté. To jsem nečekala, a myslím to hezky.\n"
"\n"
"Teď je jen udrž naživu a spokojené, dokud tu nebude ten pán z okresu. Sleduj předpověď. Plať účty. Když musíš, vlez do kanálu.\n"
"\n"
"- Teta Věra"

#: scripts/quest_manager.gd:465
msgid ""
"\n"
"\n"
"[TASK] %s"
msgstr ""
"\n"
"\n"
"[ÚKOL] %s"

#: scripts/quest_manager.gd:467
msgid ""
"\n"
"[REWARD] $%d"
msgstr ""
"\n"
"[ODMĚNA] $%d"

#: scripts/quest_manager.gd:482
msgid "%s <mirek.dvorak@seznam.cz>"
msgstr "%s <mirek.dvorak@seznam.cz>"

#: scripts/quest_manager.gd:485
msgid "One quiet night, one bed"
msgstr "Jedna klidná noc, jedna postel"

#: scripts/quest_manager.gd:486
msgid ""
"Hello reception,\n"
"\n"
"I walk the ridge trail and need one bed for one night. I do not snore and I do not drink. I pay cash.\n"
"\n"
"Archetype: Quiet Guy\n"
"Arrival: today\n"
"Total payment per day: $90\n"
"\n"
"- Mirek"
msgstr ""
"Dobrý den, recepce,\n"
"\n"
"jdu po hřebenovce a potřebuju jednu postel na jednu noc. Nechrápu a nepiju. Platím hotově.\n"
"\n"
"Archetyp: Tichoň\n"
"Příjezd: dnes\n"
"Celkem za den: $90\n"
"\n"
"- Mirek"

#: scripts/retro_materials.gd:409
msgid "sprite|%d|%d|%d|%d|%d"
msgstr "sprite|%d|%d|%d|%d|%d"

#: scripts/retro_materials.gd:446 scripts/world_generator.gd:605
#. uses 2
msgid "%d|%d|%d"
msgstr "%d|%d|%d"

#: scripts/retro_materials.gd:505
msgid "%s|%s|%s|%s|%s|%s|%s|%s"
msgstr "%s|%s|%s|%s|%s|%s|%s|%s"

#: scripts/retro_materials.gd:549
msgid ""
"#define LIT\n"
msgstr ""
"#define LIT\n"

#: scripts/retro_materials.gd:550
msgid ""
"#define ALPHA_MODE %d\n"
msgstr ""
"#define ALPHA_MODE %d\n"

#: scripts/retro_materials.gd:551
msgid ""
"#define BILLBOARD %d\n"
msgstr ""
"#define BILLBOARD %d\n"

#: scripts/retro_materials.gd:552
msgid ""
"#define TRIPLANAR\n"
msgstr ""
"#define TRIPLANAR\n"

#: scripts/retro_materials.gd:553
msgid ""
"#define EMISSION_MODE %d\n"
msgstr ""
"#define EMISSION_MODE %d\n"

#: scripts/retro_materials.gd:554
msgid ""
"#define SPRITE_LIGHT\n"
msgstr ""
"#define SPRITE_LIGHT\n"

#: scripts/retro_materials.gd:555
msgid ""
"#define VCOLOR\n"
msgstr ""
"#define VCOLOR\n"

#: scripts/retro_materials.gd:557
msgid ""
"shader_type spatial;\n"
"render_mode "
msgstr ""
"shader_type spatial;\n"
"render_mode "

#: scripts/retro_materials.gd:562
msgid ""
"\n"
"uniform sampler2D albedo_tex : source_color, filter_nearest, repeat_enable;\n"
"uniform bool has_tex = false;\n"
"uniform vec4 albedo_color : source_color = vec4(1.0);\n"
"uniform vec3 uv_scale = vec3(1.0);\n"
"uniform vec3 uv_offset = vec3(0.0);\n"
"uniform float alpha_scissor = 0.5;\n"
"uniform vec4 emission_color : source_color = vec4(0.0);\n"
"uniform float emission_energy = 0.0;\n"
"uniform sampler2D emission_tex : source_color, filter_nearest, repeat_enable;\n"
"uniform bool has_emission_tex = false;\n"
"uniform float snap_lines = 150.0;\n"
"// Pulled towards the eye along its own ray (a face or a sign on a wall, a thin board on a\n"
"// box: their own material, retro_materials _pull_of): on the screen exactly where it was,\n"
"// in depth a little in front of what it lies on. The snap moves corners a different way\n"
"// for a face and the wall under it, and a centimetre between them was not enough: they\n"
"// fought. (A plain uniform: an instance uniform took a slot for every instance drawn with\n"
"// this shader, ran out of them and crashed the game on quitting.)\n"
"uniform float depth_pull = 0.0;\n"
"uniform float affine = 0.8;\n"
"// The light as the hands have it (materials/hand_ps1.gdshader): each lamp's, the torch's\n"
"// and the sun's light in steps, the steps dithered with a 4x4 Bayer matrix on the game's\n"
"// own low-res screen pixels, as the PlayStation dithered (on a far texture's texels the\n"
"// pattern turned to moire).\n"
"// Ten steps and half the dither (playtest 19. 10.: \"the torch's light is far too harshly\n"
"// dithered\"): the bands still show, the checker between them is a fringe, not a sheet.\n"
"uniform float light_steps = 10.0;\n"
"uniform float light_dither = 0.5;\n"
"// Halfway between the stepped light and the smooth one (playtest 20. 10.: \"too strong\").\n"
"uniform float light_step_mix = 0.5;\n"
"// Build's visibility: things darken with distance in shade steps (its palette's shade\n"
"// tables), dithered between them; deeper at night (set every frame, see _visibility()).\n"
"global uniform float build_vis_dist;\n"
"global uniform float build_vis_dark;\n"
"\n"
"varying vec2 v_uv;\n"
"varying vec2 v_texel;\n"
"varying vec2 v_uv_w;\n"
"varying float v_w;\n"
"\n"
"void vertex() {\n"
"#if BILLBOARD == 1\n"
"\tMODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);\n"
"\tMODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));\n"
"\tMODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);\n"
"#elif BILLBOARD == 2\n"
"\tMODELVIEW_MATRIX = VIEW_MATRIX * mat4(vec4(normalize(cross(vec3(0.0, 1.0, 0.0), INV_VIEW_MATRIX[2].xyz)), 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(normalize(cross(INV_VIEW_MATRIX[0].xyz, vec3(0.0, 1.0, 0.0))), 0.0), MODEL_MATRIX[3]);\n"
"\tMODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));\n"
"\tMODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);\n"
"#endif\n"
"\tvec2 uv;\n"
"#ifdef TRIPLANAR\n"
"\tvec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz * uv_scale + uv_offset;\n"
"\tvec3 wn = abs(normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz));\n"
"\twp *= vec3(1.0, -1.0, 1.0);\n"
"\tif (wn.x >= wn.y && wn.x >= wn.z) {\n"
"\t\tuv = wp.zy * vec2(-1.0, 1.0);\n"
"\t} else if (wn.y >= wn.z) {\n"
"\t\tuv = wp.xz * vec2(1.0, -1.0);\n"
"\t} else {\n"
"\t\tuv = wp.xy;\n"
"\t}\n"
"#else\n"
"\tuv = UV * uv_scale.xy + uv_offset.xy;\n"
"#endif\n"
"\tvec4 vpos = MODELVIEW_MATRIX * vec4(VERTEX, 1.0);\n"
"\t// The sun's shadow pass (an orthographic view): no snap and no pull there. Snapped to\n"
"\t// the shadow map's grid every shadow jumped as the sun moved (it flickered).\n"
"\tbool ortho = PROJECTION_MATRIX[3][3] > 0.5;\n"
"\tif (!ortho) {\n"
"\t\tvpos.xyz *= 1.0 - depth_pull;\n"
"\t}\n"
"\tvec4 clip = PROJECTION_MATRIX * vpos;\n"
"\t// The PlayStation's whole-pixel vertices, on a coarse grid: edges shiver as you move.\n"
"\tif (snap_lines > 0.0 && clip.w > 0.05 && !ortho) {\n"
"\t\tvec2 grid = vec2(snap_lines * VIEWPORT_SIZE.x / max(VIEWPORT_SIZE.y, 1.0), snap_lines) * 0.5;\n"
"\t\tvec2 ndc = clip.xy / clip.w;\n"
"\t\tndc = floor(ndc * grid + 0.5) / grid;\n"
"\t\tclip.xy = ndc * clip.w;\n"
"\t}\n"
"\tPOSITION = clip;\n"
"\tv_uv = uv;\n"
"\tv_uv_w = uv * clip.w;\n"
"\tv_w = clip.w;\n"
"}\n"
"\n"
"void fragment() {\n"
"\t// The lake's mirror (camp_lake.gd) looks from under the water: nothing below the water\n"
"\t// is drawn for it (the ground's underside was a ceiling over everything it saw).\n"
"\tif (CAMERA_POSITION_WORLD.y < -0.4 && (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).y < 0.1) {\n"
"\t\tdiscard;\n"
"\t}\n"
"#ifdef LIT\n"
"#ifndef SPRITE_LIGHT\n"
"\t// The light and the sun's shadow at the true point under this pixel: on the face's own\n"
"\t// plane, along this pixel's ray. VERTEX here is where the snap moved the face to, and\n"
"\t// the shadows warped and flickered with it as you moved (the user 21. 10.: \"na stíny\n"
"\t// warpování nesmí být\"). The face still warps; its shadows stay put on the world.\n"
"\tif (snap_lines > 0.0) {\n"
"\t\tvec4 rv = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, 0.5, 1.0);\n"
"\t\tvec3 ray = normalize(rv.xyz / rv.w);\n"
"\t\tfloat den = dot(ray, NORMAL);\n"
"\t\tif (abs(den) > 0.08) {\n"
"\t\t\tfloat t = dot(VERTEX, NORMAL) / den;\n"
"\t\t\tif (t > 0.0) {\n"
"\t\t\t\tLIGHT_VERTEX = ray * t;\n"
"\t\t\t}\n"
"\t\t}\n"
"\t}\n"
"#endif\n"
"#endif\n"
"\t// Affine: interpolated across the screen, not in depth (the stretch and the swim).\n"
"\t// Not right in your face: a wall a step away would swirl into arcs (the PS1 cut its\n"
"\t// big polygons up for that); the swim is for what is a few metres off.\n"
"\tfloat near_fade = smoothstep(0.6, 3.5, v_w);\n"
"\tvec2 uv = mix(v_uv, v_uv_w / max(v_w, 0.0001), affine * near_fade);\n"
"\tvec4 c = albedo_color;\n"
"\tif (has_tex) {\n"
"\t\tc *= texture(albedo_tex, uv);\n"
"\t}\n"
"#ifdef VCOLOR\n"
"\tc *= COLOR;\n"
"#endif\n"
"\tv_texel = floor(FRAGCOORD.xy);\n"
"\tif (build_vis_dark > 0.0) {\n"
"\t\tconst float BV[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);\n"
"\t\tvec2 bm = mod(v_texel, 4.0);\n"
"\t\tfloat bd = (BV[int(bm.x) + int(bm.y) * 4] + 0.5) / 16.0 - 0.5;\n"
"\t\tfloat far = clamp(v_w / max(build_vis_dist, 1.0), 0.0, 1.0) * build_vis_dark;\n"
"\t\tfar = max(floor(far * 8.0 + 0.5 + bd * 0.6), 0.0) / 8.0;\n"
"\t\tc.rgb *= 1.0 - far;\n"
"\t}\n"
"\tALBEDO = c.rgb;\n"
"#if ALPHA_MODE == 1\n"
"\tALPHA = c.a;\n"
"\tALPHA_SCISSOR_THRESHOLD = alpha_scissor;\n"
"#elif ALPHA_MODE == 2\n"
"\tALPHA = c.a;\n"
"#endif\n"
"#if EMISSION_MODE == 1\n"
"\tvec3 e = emission_color.rgb;\n"
"\tif (has_emission_tex) {\n"
"\t\te += texture(emission_tex, uv).rgb;\n"
"\t}\n"
"\tEMISSION = e * emission_energy;\n"
"#elif EMISSION_MODE == 2\n"
"\tvec3 e = emission_color.rgb;\n"
"\tif (has_emission_tex) {\n"
"\t\te *= texture(emission_tex, uv).rgb;\n"
"\t}\n"
"\tEMISSION = e * emission_energy;\n"
"#endif\n"
"}\n"
"\n"
"#ifdef LIT\n"
"void light() {\n"
"#ifdef SPRITE_LIGHT\n"
"\tfloat ndl = 0.8;\n"
"#else\n"
"\tfloat ndl = clamp(dot(NORMAL, LIGHT), 0.0, 1.0);\n"
"#endif\n"
"\tfloat lit = ndl * ATTENUATION;\n"
"\tif (light_steps > 0.0) {\n"
"\t\tconst float B[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);\n"
"\t\tvec2 m = mod(v_texel, 4.0);\n"
"\t\tfloat d = (B[int(m.x) + int(m.y) * 4] + 0.5) / 16.0 - 0.5;\n"
"\t\tfloat stepped = max(floor(lit * light_steps + 0.5 + d * light_dither), 0.0) / light_steps;\n"
"\t\tlit = mix(lit, stepped, light_step_mix);\n"
"\t}\n"
"\tDIFFUSE_LIGHT += LIGHT_COLOR * lit / PI;\n"
"}\n"
"#endif\n"
msgstr ""
"\n"
"uniform sampler2D albedo_tex : source_color, filter_nearest, repeat_enable;\n"
"uniform bool has_tex = false;\n"
"uniform vec4 albedo_color : source_color = vec4(1.0);\n"
"uniform vec3 uv_scale = vec3(1.0);\n"
"uniform vec3 uv_offset = vec3(0.0);\n"
"uniform float alpha_scissor = 0.5;\n"
"uniform vec4 emission_color : source_color = vec4(0.0);\n"
"uniform float emission_energy = 0.0;\n"
"uniform sampler2D emission_tex : source_color, filter_nearest, repeat_enable;\n"
"uniform bool has_emission_tex = false;\n"
"uniform float snap_lines = 150.0;\n"
"// Pulled towards the eye along its own ray (a face or a sign on a wall, a thin board on a\n"
"// box: their own material, retro_materials _pull_of): on the screen exactly where it was,\n"
"// in depth a little in front of what it lies on. The snap moves corners a different way\n"
"// for a face and the wall under it, and a centimetre between them was not enough: they\n"
"// fought. (A plain uniform: an instance uniform took a slot for every instance drawn with\n"
"// this shader, ran out of them and crashed the game on quitting.)\n"
"uniform float depth_pull = 0.0;\n"
"uniform float affine = 0.8;\n"
"// The light as the hands have it (materials/hand_ps1.gdshader): each lamp's, the torch's\n"
"// and the sun's light in steps, the steps dithered with a 4x4 Bayer matrix on the game's\n"
"// own low-res screen pixels, as the PlayStation dithered (on a far texture's texels the\n"
"// pattern turned to moire).\n"
"// Ten steps and half the dither (playtest 19. 10.: \"the torch's light is far too harshly\n"
"// dithered\"): the bands still show, the checker between them is a fringe, not a sheet.\n"
"uniform float light_steps = 10.0;\n"
"uniform float light_dither = 0.5;\n"
"// Halfway between the stepped light and the smooth one (playtest 20. 10.: \"too strong\").\n"
"uniform float light_step_mix = 0.5;\n"
"// Build's visibility: things darken with distance in shade steps (its palette's shade\n"
"// tables), dithered between them; deeper at night (set every frame, see _visibility()).\n"
"global uniform float build_vis_dist;\n"
"global uniform float build_vis_dark;\n"
"\n"
"varying vec2 v_uv;\n"
"varying vec2 v_texel;\n"
"varying vec2 v_uv_w;\n"
"varying float v_w;\n"
"\n"
"void vertex() {\n"
"#if BILLBOARD == 1\n"
"\tMODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);\n"
"\tMODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));\n"
"\tMODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);\n"
"#elif BILLBOARD == 2\n"
"\tMODELVIEW_MATRIX = VIEW_MATRIX * mat4(vec4(normalize(cross(vec3(0.0, 1.0, 0.0), INV_VIEW_MATRIX[2].xyz)), 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(normalize(cross(INV_VIEW_MATRIX[0].xyz, vec3(0.0, 1.0, 0.0))), 0.0), MODEL_MATRIX[3]);\n"
"\tMODELVIEW_MATRIX = MODELVIEW_MATRIX * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));\n"
"\tMODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);\n"
"#endif\n"
"\tvec2 uv;\n"
"#ifdef TRIPLANAR\n"
"\tvec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz * uv_scale + uv_offset;\n"
"\tvec3 wn = abs(normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz));\n"
"\twp *= vec3(1.0, -1.0, 1.0);\n"
"\tif (wn.x >= wn.y && wn.x >= wn.z) {\n"
"\t\tuv = wp.zy * vec2(-1.0, 1.0);\n"
"\t} else if (wn.y >= wn.z) {\n"
"\t\tuv = wp.xz * vec2(1.0, -1.0);\n"
"\t} else {\n"
"\t\tuv = wp.xy;\n"
"\t}\n"
"#else\n"
"\tuv = UV * uv_scale.xy + uv_offset.xy;\n"
"#endif\n"
"\tvec4 vpos = MODELVIEW_MATRIX * vec4(VERTEX, 1.0);\n"
"\t// The sun's shadow pass (an orthographic view): no snap and no pull there. Snapped to\n"
"\t// the shadow map's grid every shadow jumped as the sun moved (it flickered).\n"
"\tbool ortho = PROJECTION_MATRIX[3][3] > 0.5;\n"
"\tif (!ortho) {\n"
"\t\tvpos.xyz *= 1.0 - depth_pull;\n"
"\t}\n"
"\tvec4 clip = PROJECTION_MATRIX * vpos;\n"
"\t// The PlayStation's whole-pixel vertices, on a coarse grid: edges shiver as you move.\n"
"\tif (snap_lines > 0.0 && clip.w > 0.05 && !ortho) {\n"
"\t\tvec2 grid = vec2(snap_lines * VIEWPORT_SIZE.x / max(VIEWPORT_SIZE.y, 1.0), snap_lines) * 0.5;\n"
"\t\tvec2 ndc = clip.xy / clip.w;\n"
"\t\tndc = floor(ndc * grid + 0.5) / grid;\n"
"\t\tclip.xy = ndc * clip.w;\n"
"\t}\n"
"\tPOSITION = clip;\n"
"\tv_uv = uv;\n"
"\tv_uv_w = uv * clip.w;\n"
"\tv_w = clip.w;\n"
"}\n"
"\n"
"void fragment() {\n"
"\t// The lake's mirror (camp_lake.gd) looks from under the water: nothing below the water\n"
"\t// is drawn for it (the ground's underside was a ceiling over everything it saw).\n"
"\tif (CAMERA_POSITION_WORLD.y < -0.4 && (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).y < 0.1) {\n"
"\t\tdiscard;\n"
"\t}\n"
"#ifdef LIT\n"
"#ifndef SPRITE_LIGHT\n"
"\t// The light and the sun's shadow at the true point under this pixel: on the face's own\n"
"\t// plane, along this pixel's ray. VERTEX here is where the snap moved the face to, and\n"
"\t// the shadows warped and flickered with it as you moved (the user 21. 10.: \"na stíny\n"
"\t// warpování nesmí být\"). The face still warps; its shadows stay put on the world.\n"
"\tif (snap_lines > 0.0) {\n"
"\t\tvec4 rv = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, 0.5, 1.0);\n"
"\t\tvec3 ray = normalize(rv.xyz / rv.w);\n"
"\t\tfloat den = dot(ray, NORMAL);\n"
"\t\tif (abs(den) > 0.08) {\n"
"\t\t\tfloat t = dot(VERTEX, NORMAL) / den;\n"
"\t\t\tif (t > 0.0) {\n"
"\t\t\t\tLIGHT_VERTEX = ray * t;\n"
"\t\t\t}\n"
"\t\t}\n"
"\t}\n"
"#endif\n"
"#endif\n"
"\t// Affine: interpolated across the screen, not in depth (the stretch and the swim).\n"
"\t// Not right in your face: a wall a step away would swirl into arcs (the PS1 cut its\n"
"\t// big polygons up for that); the swim is for what is a few metres off.\n"
"\tfloat near_fade = smoothstep(0.6, 3.5, v_w);\n"
"\tvec2 uv = mix(v_uv, v_uv_w / max(v_w, 0.0001), affine * near_fade);\n"
"\tvec4 c = albedo_color;\n"
"\tif (has_tex) {\n"
"\t\tc *= texture(albedo_tex, uv);\n"
"\t}\n"
"#ifdef VCOLOR\n"
"\tc *= COLOR;\n"
"#endif\n"
"\tv_texel = floor(FRAGCOORD.xy);\n"
"\tif (build_vis_dark > 0.0) {\n"
"\t\tconst float BV[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);\n"
"\t\tvec2 bm = mod(v_texel, 4.0);\n"
"\t\tfloat bd = (BV[int(bm.x) + int(bm.y) * 4] + 0.5) / 16.0 - 0.5;\n"
"\t\tfloat far = clamp(v_w / max(build_vis_dist, 1.0), 0.0, 1.0) * build_vis_dark;\n"
"\t\tfar = max(floor(far * 8.0 + 0.5 + bd * 0.6), 0.0) / 8.0;\n"
"\t\tc.rgb *= 1.0 - far;\n"
"\t}\n"
"\tALBEDO = c.rgb;\n"
"#if ALPHA_MODE == 1\n"
"\tALPHA = c.a;\n"
"\tALPHA_SCISSOR_THRESHOLD = alpha_scissor;\n"
"#elif ALPHA_MODE == 2\n"
"\tALPHA = c.a;\n"
"#endif\n"
"#if EMISSION_MODE == 1\n"
"\tvec3 e = emission_color.rgb;\n"
"\tif (has_emission_tex) {\n"
"\t\te += texture(emission_tex, uv).rgb;\n"
"\t}\n"
"\tEMISSION = e * emission_energy;\n"
"#elif EMISSION_MODE == 2\n"
"\tvec3 e = emission_color.rgb;\n"
"\tif (has_emission_tex) {\n"
"\t\te *= texture(emission_tex, uv).rgb;\n"
"\t}\n"
"\tEMISSION = e * emission_energy;\n"
"#endif\n"
"}\n"
"\n"
"#ifdef LIT\n"
"void light() {\n"
"#ifdef SPRITE_LIGHT\n"
"\tfloat ndl = 0.8;\n"
"#else\n"
"\tfloat ndl = clamp(dot(NORMAL, LIGHT), 0.0, 1.0);\n"
"#endif\n"
"\tfloat lit = ndl * ATTENUATION;\n"
"\tif (light_steps > 0.0) {\n"
"\t\tconst float B[16] = float[16](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);\n"
"\t\tvec2 m = mod(v_texel, 4.0);\n"
"\t\tfloat d = (B[int(m.x) + int(m.y) * 4] + 0.5) / 16.0 - 0.5;\n"
"\t\tfloat stepped = max(floor(lit * light_steps + 0.5 + d * light_dither), 0.0) / light_steps;\n"
"\t\tlit = mix(lit, stepped, light_step_mix);\n"
"\t}\n"
"\tDIFFUSE_LIGHT += LIGHT_COLOR * lit / PI;\n"
"}\n"
"#endif\n"

