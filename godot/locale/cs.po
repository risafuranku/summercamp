#: core/systems/guest_needs_system.gd:108
msgid "A caravan with a fridge. The beer stays cold."
msgstr "Karavan s lednicí. Pivo zůstane studený."

#: core/systems/guest_needs_system.gd:108
msgid "Smells like a festival in here. Lovely."
msgstr "Smrdí to tu jak na festivalu. Paráda."

#: core/systems/guest_needs_system.gd:109
msgid "A tent? Where am I supposed to plug in the hairdryer?"
msgstr "Stan? A kam si mám jako zapojit fén?"

#: core/systems/guest_needs_system.gd:109
msgid "No shower in the room? Seriously?"
msgstr "Na pokoji není sprcha? Vážně?"

#: core/systems/guest_needs_system.gd:109
msgid "A shower of my own. Finally."
msgstr "Vlastní sprcha. Konečně."

#: core/systems/guest_needs_system.gd:109
msgid "Now THIS is a holiday."
msgstr "No TOHLE je dovolená."

#: core/systems/guest_needs_system.gd:109
msgid "It smells of old gas in here."
msgstr "Je tu cítit starej plyn."

#: core/systems/guest_needs_system.gd:109
msgid "Fairy lights! It's like a little doll's house."
msgstr "Světýlka! Je to jak domeček pro panenky."

#: core/systems/guest_needs_system.gd:110
msgid "Canvas over my head, the sky above that. Perfect."
msgstr "Nad hlavou plachta, nad ní nebe. Tak to má bejt."

#: core/systems/guest_needs_system.gd:110
msgid "A bit posh, all these walls."
msgstr "Trochu moc nóbl, samý zdi."

#: core/systems/guest_needs_system.gd:111
msgid "Four of us in a tent. The kids will freeze."
msgstr "Čtyři lidi ve stanu. Děti nám zmrznou."

#: core/systems/guest_needs_system.gd:111
msgid "A proper roof for the kids."
msgstr "Pořádná střecha pro děti."

#: core/systems/guest_needs_system.gd:111
