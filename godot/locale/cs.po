msgstr "row:%d"

#: scripts/town/ticket_machine_closeup.gd:97
msgid "Storno: cancelled."
msgstr "Storno: zrušeno."

#: scripts/town/ticket_machine_closeup.gd:99
msgid "A blank label. The button does nothing."
msgstr "Prázdný štítek. Tlačítko nic nedělá."

#: scripts/town/ticket_machine_closeup.gd:102
msgid "%s: $%d. Coins in the slot."
msgstr "%s: $%d. Mince do otvoru."

#: scripts/town/ticket_machine_closeup.gd:114
msgid "It rattles. PORUCHA: out of order. Hit it again."
msgstr "Zachrastí to. PORUCHA. Bouchni do něj znovu."

#: scripts/town/ticket_machine_closeup.gd:127
msgid "The coin rattles straight down into the return cup. Pick a fare first."
msgstr "Mince propadne rovnou do vratné misky. Nejdřív vyber zastávku."

#: scripts/town/ticket_machine_closeup.gd:131
msgid "No room in your bag for a ticket."
msgstr "Na jízdenku nemáš v tašce místo."

#: scripts/town/ticket_machine_closeup.gd:135
msgid "Not enough in your pockets."
msgstr "Tolik v kapsách nemáš."

#: scripts/town/ticket_machine_closeup.gd:142
msgid "It takes the coins. Then nothing. The LCD says PORUCHA."
msgstr "Mince spolkne. Pak nic. Na displeji svítí PORUCHA."

#: scripts/town/ticket_machine_closeup.gd:151
msgid "It whirrs and clicks. TISKNU: printing."
msgstr "Zabzučí a cvakne. TISKNU."

#: scripts/town/ticket_machine_closeup.gd:157
msgid "No room in your bag for it."
msgstr "Nemáš ji kam dát, taška je plná."

#: scripts/town/ticket_machine_closeup.gd:160
msgid "A ticket to %s, $%d. Punch it in the orange box on the bus."
msgstr "Jízdenka: %s, $%d. V autobuse ji označ v oranžovém štípači."

#: scripts/town/ticket_machine_closeup.gd:172
msgid "VEZMĚTE SI JÍZDENKU: take your ticket."
msgstr "VEZMĚTE SI JÍZDENKU."

#: scripts/town/ticket_machine_closeup.gd:194
