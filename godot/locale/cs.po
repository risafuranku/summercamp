msgstr "Přistoupim,rozc."

#: scripts/town/timetable_closeup.gd:72
msgid "Zastavuje jen na"
msgstr "Zastavuje jen na"

#: scripts/town/timetable_closeup.gd:72
msgid "znamení. Stůjte u"
msgstr "znamení. Stůjte u"

#: scripts/town/timetable_closeup.gd:72
msgid "sloupku, ať vás řidič"
msgstr "sloupku, ať vás řidič"

#: scripts/town/timetable_closeup.gd:72
