msgid "STAMGAST. The regulars' table. Nobody sits there, even when it is empty."
msgstr "ŠTAMGAST. Stůl pro štamgasty. Nikdo si tam nesedá, ani když je prázdný."

#: scripts/pub/pub_layout.gd:194
msgid "From the Slavia hotel. Somebody walked out with it in 1979."
msgstr "Z hotelu Slavia. V roce 1979 si ho někdo odnesl."

#: scripts/pub/pub_layout.gd:198
msgid "brewery sign"
msgstr "cedule pivovaru"

#: scripts/pub/pub_layout.gd:198
msgid "The brewery closed in 1991. The sign stayed; the beer changed."
msgstr "Pivovar zavřeli v roce 1991. Cedule zůstala, pivo je jiné."

