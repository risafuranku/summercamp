"\n"
"shader_type canvas_item;\n"
"uniform sampler2D mask_tex : filter_linear;\n"
"uniform vec2 flip = vec2(0.0);\n"
"uniform float fade = 1.0;\n"
"void fragment() {\n"
"\tvec2 uv = mix(UV, 1.0 - UV, flip);\n"
"\tvec4 c = texture(TEXTURE, uv);\n"
"\tc.a *= texture(mask_tex, UV).r * fade;\n"
"\tCOLOR = c;\n"
"}\n"
msgstr ""
"\n"
"shader_type canvas_item;\n"
"uniform sampler2D mask_tex : filter_linear;\n"
"uniform vec2 flip = vec2(0.0);\n"
"uniform float fade = 1.0;\n"
"void fragment() {\n"
"\tvec2 uv = mix(UV, 1.0 - UV, flip);\n"
"\tvec4 c = texture(TEXTURE, uv);\n"
"\tc.a *= texture(mask_tex, UV).r * fade;\n"
"\tCOLOR = c;\n"
"}\n"

