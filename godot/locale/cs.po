msgstr "SK Liblice. V 1983 postup, v 1984 sestup."

#: scripts/pub/pub_layout.gd:203
msgid "September 1986. Nobody has turned it over."
msgstr "Září 1986. Nikdo ho nepřetočil."

#: scripts/pub/pub_layout.gd:205
msgid "Ten to closing. It always says ten to closing."
msgstr "Deset minut do zavíračky. Pořád ukazují deset minut do zavíračky."

