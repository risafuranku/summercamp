#: scripts/town/car_closeup.gd:59
msgid "She runs. Rough, loud, alive."
msgstr "Běží. Chrčí, řve, žije."

#: scripts/town/car_closeup.gd:61
msgid "The engine of a Skoda 120, at the back where they keep it. Something is missing from most of it."
msgstr "Motor škodovky 120, vzadu, kde ho mají. Skoro všemu na něm něco chybí."

#: scripts/town/car_closeup.gd:69
msgid "pulley:%d"
msgstr "pulley:%d"

#: scripts/town/car_closeup.gd:84
msgid "Best not touch anything now it runs."
msgstr "Teď, když běží, radši na nic nesahej."

#: scripts/town/car_closeup.gd:92
msgid "The battery sits in its tray. It was the Trabant's."
msgstr "Baterie sedí v držáku. Je z trabantu."

#: scripts/town/car_closeup.gd:97
msgid "In it goes. Heavy, and it smells of the Trabant. Now the cables."
msgstr "Dovnitř s ní. Těžká a páchne trabantem. Teď kabely."

#: scripts/town/car_closeup.gd:99 scripts/town/car_closeup.gd:117 scripts/town/car_closeup.gd:142 scripts/town/car_closeup.gd:170 (+1)
#. uses 5
msgid "VONDRA"
msgstr "VONDRA"

#: scripts/town/car_closeup.gd:99
msgid "That battery went flat in ninety-one. The Trabant behind my house still has one in it."
msgstr "Ta baterka je vybitá od jednadevadesátýho. V trabantu za barákem ještě jedna je."

#: scripts/town/car_closeup.gd:102
msgid "A loose cable, its clamp green with rot."
msgstr "Uvolněný kabel, svorka zelená od koroze."

#: scripts/town/car_closeup.gd:104
msgid "Tight."
msgstr "Utaženo."

#: scripts/town/car_closeup.gd:108
msgid "A spark, a snap. It holds."
msgstr "Jiskra, cvaknutí. Drží."

#: scripts/town/car_closeup.gd:108
msgid "A spark, a snap. Both cables on."
msgstr "Jiskra, cvaknutí. Oba kabely nasazené."

#: scripts/town/car_closeup.gd:111
msgid "Full. Of Babetta."
msgstr "Plná. Z Babetty."

#: scripts/town/car_closeup.gd:113
msgid "Hold the button to pour."
msgstr "Podrž tlačítko a nalévej."

#: scripts/town/car_closeup.gd:115
msgid "The can is empty. Something by the road still has petrol in it."
msgstr "Kanystr je prázdný. Něco u silnice má v sobě ještě benzín."

#: scripts/town/car_closeup.gd:117
msgid "Bone dry, the tank. The can is in the garage, by the wall."
msgstr "Nádrž suchá jak troud. Kanystr je v garáži u zdi."

#: scripts/town/car_closeup.gd:120
msgid "The starter. You two have had words."
msgstr "Startér. S tím sis to už {g:vyříkal|vyříkala}."

#: scripts/town/car_closeup.gd:124
msgid "Clank. Clank. Something inside it gives."
msgstr "Klap. Klap. Něco uvnitř povolí."

#: scripts/town/car_closeup.gd:126
msgid "The starter motor: black, greasy, stubborn."
msgstr "Startér: černý, mastný, paličatý."

#: scripts/town/car_closeup.gd:128
msgid "An oily rag. Vondra's handkerchief too, by the look of it."
msgstr "Mastný hadr. Podle všeho zároveň Vondrův kapesník."

#: scripts/town/car_closeup.gd:139
msgid "Mrs Vondrova's stockings, three times round. Holding."
msgstr "Punčochy paní Vondrové, třikrát dokola. Drží."

#: scripts/town/car_closeup.gd:142
msgid "The fan belt snapped in ninety-one. My Marie always said a stocking will do."
msgstr "Klínovej řemen praskl v jednadevadesátým. Moje Marie vždycky říkala, že punčocha stačí."

#: scripts/town/car_closeup.gd:145
msgid "Already round that one."
msgstr "Kolem téhle už je."

#: scripts/town/car_closeup.gd:152
msgid "Round all four and knotted. It will do to Liblice and back. Probably."
msgstr "Kolem všech čtyř a zauzlovaná. Do Liblic a zpátky to vydrží. Asi."

#: scripts/town/car_closeup.gd:154
msgid "Round that one. %d to go."
msgstr "Kolem téhle. Ještě %d."

#: scripts/town/car_closeup.gd:161
msgid "She is running. Leave her be."
msgstr "Běží. Nech ji být."

#: scripts/town/car_closeup.gd:164
msgid "Nothing. Not even a click."
msgstr "Nic. Ani necvakne."

#: scripts/town/car_closeup.gd:170
msgid "It only clicks? Hit the starter! Not hard. Like you mean it."
msgstr "Jenom cvaká? Prašti do startéru! Ne moc. Ale od srdce."

#: scripts/town/car_closeup.gd:172
msgid "Click. Only the click."
msgstr "Cvak. Jenom cvak."

#: scripts/town/car_closeup.gd:176
msgid "It turns over and over. Nothing to burn."
msgstr "Točí a točí. Nemá co pálit."

#: scripts/town/car_closeup.gd:180
msgid "It catches, something screams, it dies. The fan belt."
msgstr "Chytne, něco zaječí, chcípne. Klínový řemen."

#: scripts/town/car_closeup.gd:184
msgid "Listen to her! Like a sewing machine full of nails!"
msgstr "Slyšíš ji? Jak šicí stroj plnej hřebíků!"

#: scripts/town/car_closeup.gd:200
msgid "The can is empty and the tank is full. Of Babetta."
msgstr "Kanystr je prázdný a nádrž plná. Z Babetty."

#: scripts/town/hamlet_trip.gd:256 scripts/town/town_trip.gd:213
#. uses 2
msgid "Read the timetable"
msgstr "Přečíst jízdní řád"

#: scripts/town/hamlet_trip.gd:258
msgid "Talk to Mr Vondra"
msgstr "Promluvit s panem Vondrou"

#: scripts/town/hamlet_trip.gd:260
msgid "Look at the Skoda"
msgstr "Prohlédnout škodovku"

#: scripts/town/hamlet_trip.gd:262
msgid "Take the petrol can"
msgstr "Vzít kanystr"

#: scripts/town/hamlet_trip.gd:264
msgid "Siphon the petrol"
msgstr "Odsát benzín"

#: scripts/town/hamlet_trip.gd:264
msgid "Look at the Babetta"
msgstr "Prohlédnout babettu"

#: scripts/town/hamlet_trip.gd:266
msgid "Look at the Trabant"
msgstr "Prohlédnout trabanta"

#: scripts/town/hamlet_trip.gd:266
msgid "Take the battery"
msgstr "Vzít baterii"

#: scripts/town/hamlet_trip.gd:268
msgid "Take the stockings"
msgstr "Vzít punčochy"

#: scripts/town/hamlet_trip.gd:270
msgid "Take the hammer"
msgstr "Vzít kladivo"

#: scripts/town/hamlet_trip.gd:272
msgid "Look into the ruin"
msgstr "Nahlédnout do rozvaliny"

#: scripts/town/hamlet_trip.gd:287
msgid "An empty petrol can. It sloshes with nothing."
msgstr "Prázdný kanystr. Nic v něm nešplouchá."

#: scripts/town/hamlet_trip.gd:293
msgid "A suck on the hose, a mouthful of Babetta, and the can is full. Mostly."
msgstr "Nasát hadičkou, plná pusa Babetty a kanystr je plný. Skoro."

#: scripts/town/hamlet_trip.gd:295 scripts/town/town_trip.gd:355
#. uses 2
msgid "The can is full already."
msgstr "Kanystr už je plný."

#: scripts/town/hamlet_trip.gd:297
msgid "The Babetta's tank sloshes. Half full, after all these years. You need something to put it in."
msgstr "V nádržce babetty to šplouchá. Po těch letech napůl plná. Potřebuješ to do něčeho přelít."

#: scripts/town/hamlet_trip.gd:300
msgid "The Trabant, on its blocks. Mice live in it now."
msgstr "Trabant na špalcích. Teď v něm bydlí myši."

#: scripts/town/hamlet_trip.gd:305
msgid "The Trabant's battery, from under a mouse nest. Heavy. Is there anything left in it?"
msgstr "Baterie z trabantu, zpod myšího hnízda. Těžká. Zbylo v ní ještě něco?"

#: scripts/town/hamlet_trip.gd:308
msgid "A pair of stockings off the line. Beige. Nobody is coming for them."
msgstr "Punčochy ze šňůry. Béžové. Nikdo si pro ně nepřijde."

#: scripts/town/hamlet_trip.gd:311
msgid "The hammer from the block. The handle is warm, as if somebody just put it down."
msgstr "Kladivo ze špalku. Násada je teplá, jako by ho někdo právě odložil."

#: scripts/town/hamlet_trip.gd:347 scripts/town/hamlet_trip.gd:350 scripts/town/hamlet_trip.gd:352 scripts/town/hamlet_trip.gd:354 (+5)
#. uses 9
msgid "Vondra"
msgstr "Vondra"

#: scripts/town/hamlet_trip.gd:347
msgid "You got off here? Nobody gets off here. That is my Skoda in the garage. She has not gone since my boy went to Germany. Get her going and there is fifty in it for you. Parts? Everything here is parts."
msgstr "Ty jsi tu {g:vystoupil|vystoupila}? Tady nikdo nevystupuje. V garáži je moje škodovka. Nejela od tý doby, co syn odjel do Němec. Rozjeď ji a máš u mě pětistovku. Díly? Tady je všechno díly."

#: scripts/town/hamlet_trip.gd:350
msgid "The battery is as dead as Brezhnev. The Trabant behind my house still has one."
msgstr "Baterka je mrtvá jak Brežněv. V trabantu za barákem ještě jedna je."

#: scripts/town/hamlet_trip.gd:352
msgid "Petrol? The Babetta by the Hronek ruin, up at the road. Her tank never emptied. The can is by the wall in the garage."
msgstr "Benzín? Babetta u Hronkovy rozvaliny, nahoře u silnice. Tý se nádržka nikdy nevyprázdnila. Kanystr je v garáži u zdi."

#: scripts/town/hamlet_trip.gd:354
msgid "The fan belt went in ninety-one. Marie, God rest her, always said a stocking will do. There are some on the line."
msgstr "Řemen odešel v jednadevadesátým. Marie, dej jí pánbůh věčnou slávu, vždycky říkala, že punčocha stačí. Na šňůře nějaký visej."

#: scripts/town/hamlet_trip.gd:356
msgid "If she only clicks, you hit the starter. The hammer is in the block by the woodpile."
msgstr "Jestli jenom cvaká, prašti do startéru. Kladivo je ve špalku u dříví."

#: scripts/town/hamlet_trip.gd:358
msgid "Well? Go on. The key is in her."
msgstr "No? Do toho. Klíček je v ní."

#: scripts/town/hamlet_trip.gd:364
msgid "Listen to her! Here, fifty, as I said. And when you go back up to that camp: not the last bus. The one before."
msgstr "Slyšíš ji? Tady, pětistovka, jak jsem řek. A až pojedeš nahoru do toho kempu: ne posledním autobusem. Tím před ním."

#: scripts/town/hamlet_trip.gd:418
msgid "Now? After dark? Up to the lake? Not for anything. In the morning."
msgstr "Teď? Po tmě? Nahoru k jezeru? Ani za nic. Ráno."

#: scripts/town/hamlet_trip.gd:420
msgid "Shall I run you up to the camp? Sit in the front."
msgstr "Mám tě hodit nahoru do kempu? Sedni si dopředu."

#: scripts/town/hamlet_trip.gd:424
msgid "Vondra's Skoda goes back down the lane."
msgstr "Vondrova škodovka odjíždí zpátky dolů po cestě."

#: scripts/town/liblice_masts.gd:37
msgid ""
"\n"
"shader_type spatial;\n"
"render_mode unshaded, fog_disabled, cull_disabled;\n"
"uniform vec4 haze_color : source_color = vec4(0.7, 0.76, 0.82, 1.0);\n"
"uniform float haze = 0.5;\n"
"uniform float light = 1.0;\n"
"uniform float height = 355.0;\n"
"uniform float bands = 15.0;\n"
"varying float h;\n"
"void vertex() {\n"
"\th = VERTEX.y;\n"
"}\n"
"void fragment() {\n"
"\tfloat b = mod(floor(clamp(h / height, 0.0, 0.999) * bands), 2.0);\n"
"\tvec3 col = mix(vec3(0.74, 0.13, 0.09), vec3(0.93, 0.92, 0.88), b);\n"
"\t// The lattice: the zigzag of its bracing darker against the paint.\n"
"\tfloat z = abs(fract(UV.x * 3.0 + h / 4.0) - 0.5);\n"
"\tfloat z2 = abs(fract(UV.x * 3.0 - h / 4.0) - 0.5);\n"
"\tcol *= (z < 0.07 || z2 < 0.07) ? 0.62 : 1.0;\n"
"\tALBEDO = mix(col * light, haze_color.rgb, haze);\n"
"}\n"
msgstr ""

#: scripts/town/liblice_masts.gd:61
msgid ""
"\n"
"shader_type spatial;\n"
"render_mode unshaded, fog_disabled, cull_disabled;\n"
"uniform vec4 color : source_color = vec4(1.0, 0.18, 0.08, 1.0);\n"
"uniform float glow = 1.0;\n"
"uniform float size = 0.011;\n"
"void vertex() {\n"
"\tvec4 c = MODELVIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0);\n"
"\tPOSITION = PROJECTION_MATRIX * (c + vec4(VERTEX.xy * -c.z * size, 0.0, 0.0));\n"
"}\n"
"void fragment() {\n"
"\tALBEDO = color.rgb * glow;\n"
"}\n"
msgstr ""
"\n"
"shader_type spatial;\n"
"render_mode unshaded, fog_disabled, cull_disabled;\n"
"uniform vec4 color : source_color = vec4(1.0, 0.18, 0.08, 1.0);\n"
"uniform float glow = 1.0;\n"
"uniform float size = 0.011;\n"
"void vertex() {\n"
"\tvec4 c = MODELVIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0);\n"
"\tPOSITION = PROJECTION_MATRIX * (c + vec4(VERTEX.xy * -c.z * size, 0.0, 0.0));\n"
"}\n"
"void fragment() {\n"
"\tALBEDO = color.rgb * glow;\n"
"}\n"

#: scripts/town/liblice_masts.gd:76
msgid ""
"\n"
"shader_type spatial;\n"
"render_mode unshaded, fog_disabled, cull_disabled;\n"
"uniform vec4 haze_color : source_color = vec4(0.7, 0.76, 0.82, 1.0);\n"
"uniform float haze = 0.5;\n"
"uniform float light = 1.0;\n"
"void fragment() {\n"
"\t// The guys barely show against the sky, as in the photographs.\n"
"\tALBEDO = mix(vec3(0.3, 0.3, 0.32) * light, haze_color.rgb, haze);\n"
"\tALPHA = 0.3 * (1.0 - haze);\n"
"}\n"
msgstr ""
"\n"
"shader_type spatial;\n"
"render_mode unshaded, fog_disabled, cull_disabled;\n"
"uniform vec4 haze_color : source_color = vec4(0.7, 0.76, 0.82, 1.0);\n"
"uniform float haze = 0.5;\n"
"uniform float light = 1.0;\n"
"void fragment() {\n"
"\t// The guys barely show against the sky, as in the photographs.\n"
"\tALBEDO = mix(vec3(0.3, 0.3, 0.32) * light, haze_color.rgb, haze);\n"
"\tALPHA = 0.3 * (1.0 - haze);\n"
"}\n"

#: scripts/town/pockets.gd:56
msgid ""
"\n"
"shader_type canvas_item;\n"
"uniform sampler2D screen : hint_screen_texture, filter_nearest;\n"
"uniform float amount = 0.0;\n"
"uniform float t = 0.0;\n"
"uniform float jolt = 0.0;\n"
"void fragment() {\n"
"\tvec2 uv = SCREEN_UV;\n"
"\tfloat a = amount * 0.012;\n"
"\t// The world leans one way and the other, slowly.\n"
"\tfloat roll = sin(t * 0.37) * amount * 0.018;\n"
"\tvec2 c0 = uv - 0.5;\n"
"\tuv = vec2(c0.x * cos(roll) - c0.y * sin(roll), c0.x * sin(roll) + c0.y * cos(roll)) + 0.5;\n"
"\tuv.x += sin(uv.y * 9.0 + t * 1.7) * a;\n"
"\tuv.y += cos(uv.x * 7.0 + t * 1.3) * a * 0.7 + jolt * 0.012;\n"
"\tvec3 c = texture(screen, uv).rgb;\n"
"\t// A ghost of the view to one side, the way the eyes stop agreeing.\n"
"\tfloat g_off = a * 2.2 + amount * 0.004 * (1.0 + sin(t * 0.61));\n"
"\tvec3 g = texture(screen, uv + vec2(g_off, 0.0)).rgb;\n"
"\tCOLOR = vec4(mix(c, (c + g) * 0.5, clamp(amount * 0.8, 0.0, 0.6)), 1.0);\n"
"}\n"
msgstr ""
"\n"
"shader_type canvas_item;\n"
"uniform sampler2D screen : hint_screen_texture, filter_nearest;\n"
"uniform float amount = 0.0;\n"
"uniform float t = 0.0;\n"
"uniform float jolt = 0.0;\n"
"void fragment() {\n"
"\tvec2 uv = SCREEN_UV;\n"
"\tfloat a = amount * 0.012;\n"
"\t// The world leans one way and the other, slowly.\n"
"\tfloat roll = sin(t * 0.37) * amount * 0.018;\n"
"\tvec2 c0 = uv - 0.5;\n"
"\tuv = vec2(c0.x * cos(roll) - c0.y * sin(roll), c0.x * sin(roll) + c0.y * cos(roll)) + 0.5;\n"
"\tuv.x += sin(uv.y * 9.0 + t * 1.7) * a;\n"
"\tuv.y += cos(uv.x * 7.0 + t * 1.3) * a * 0.7 + jolt * 0.012;\n"
"\tvec3 c = texture(screen, uv).rgb;\n"
"\t// A ghost of the view to one side, the way the eyes stop agreeing.\n"
"\tfloat g_off = a * 2.2 + amount * 0.004 * (1.0 + sin(t * 0.61));\n"
"\tvec3 g = texture(screen, uv + vec2(g_off, 0.0)).rgb;\n"
"\tCOLOR = vec4(mix(c, (c + g) * 0.5, clamp(amount * 0.8, 0.0, 0.6)), 1.0);\n"
"}\n"

