#: scripts/os98/apps/browser_app.gd:1463
msgid "there are lights by the fence"
msgstr "u plotu jsou světla"

#: scripts/os98/apps/browser_app.gd:1464
msgid "i counted them at ten. i counted them again"
msgstr "v deset jsem je {g:spočítal|spočítala}. {g:spočítal|spočítala} jsem je znova"

#: scripts/os98/apps/browser_app.gd:1465
