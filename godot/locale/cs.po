#: scripts/town/liblice_masts.gd:37
msgid ""
"\n"
"shader_type spatial;\n"
"render_mode unshaded, fog_disabled, cull_disabled;\n"
"uniform vec4 haze_color : source_color = vec4(0.7, 0.76, 0.82, 1.0);\n"
"uniform float haze = 0.5;\n"
"uniform float light = 1.0;\n"
"uniform float height = 355.0;\n"
"uniform float bands = 15.0;\n"
"varying float h;\n"
"void vertex() {\n"
"\th = VERTEX.y;\n"
"}\n"
"void fragment() {\n"
"\tfloat b = mod(floor(clamp(h / height, 0.0, 0.999) * bands), 2.0);\n"
"\tvec3 col = mix(vec3(0.74, 0.13, 0.09), vec3(0.93, 0.92, 0.88), b);\n"
"\t// The lattice: the zigzag of its bracing darker against the paint.\n"
"\tfloat z = abs(fract(UV.x * 3.0 + h / 4.0) - 0.5);\n"
"\tfloat z2 = abs(fract(UV.x * 3.0 - h / 4.0) - 0.5);\n"
"\tcol *= (z < 0.07 || z2 < 0.07) ? 0.62 : 1.0;\n"
"\tALBEDO = mix(col * light, haze_color.rgb, haze);\n"
"}\n"
msgstr ""

#: scripts/town/liblice_masts.gd:61
msgid ""
"\n"
"shader_type spatial;\n"
"render_mode unshaded, fog_disabled, cull_disabled;\n"
"uniform vec4 color : source_color = vec4(1.0, 0.18, 0.08, 1.0);\n"
"uniform float glow = 1.0;\n"
"uniform float size = 0.011;\n"
"void vertex() {\n"
"\tvec4 c = MODELVIEW_MATRIX * vec4(0.0, 0.0, 0.0, 1.0);\n"
"\tPOSITION = PROJECTION_MATRIX * (c + vec4(VERTEX.xy * -c.z * size, 0.0, 0.0));\n"
"}\n"
"void fragment() {\n"
"\tALBEDO = color.rgb * glow;\n"
"}\n"
msgstr ""

#: scripts/town/liblice_masts.gd:76
msgid ""
"\n"
"shader_type spatial;\n"
"render_mode unshaded, fog_disabled, cull_disabled;\n"
"uniform vec4 haze_color : source_color = vec4(0.7, 0.76, 0.82, 1.0);\n"
"uniform float haze = 0.5;\n"
"uniform float light = 1.0;\n"
"void fragment() {\n"
"\t// The guys barely show against the sky, as in the photographs.\n"
"\tALBEDO = mix(vec3(0.3, 0.3, 0.32) * light, haze_color.rgb, haze);\n"
"\tALPHA = 0.3 * (1.0 - haze);\n"
"}\n"
msgstr ""

#: scripts/town/pockets.gd:56
msgid ""
"\n"
"shader_type canvas_item;\n"
"uniform sampler2D screen : hint_screen_texture, filter_nearest;\n"
"uniform float amount = 0.0;\n"
"uniform float t = 0.0;\n"
"uniform float jolt = 0.0;\n"
"void fragment() {\n"
"\tvec2 uv = SCREEN_UV;\n"
"\tfloat a = amount * 0.012;\n"
"\t// The world leans one way and the other, slowly.\n"
"\tfloat roll = sin(t * 0.37) * amount * 0.018;\n"
"\tvec2 c0 = uv - 0.5;\n"
"\tuv = vec2(c0.x * cos(roll) - c0.y * sin(roll), c0.x * sin(roll) + c0.y * cos(roll)) + 0.5;\n"
"\tuv.x += sin(uv.y * 9.0 + t * 1.7) * a;\n"
"\tuv.y += cos(uv.x * 7.0 + t * 1.3) * a * 0.7 + jolt * 0.012;\n"
"\tvec3 c = texture(screen, uv).rgb;\n"
"\t// A ghost of the view to one side, the way the eyes stop agreeing.\n"
"\tfloat g_off = a * 2.2 + amount * 0.004 * (1.0 + sin(t * 0.61));\n"
"\tvec3 g = texture(screen, uv + vec2(g_off, 0.0)).rgb;\n"
"\tCOLOR = vec4(mix(c, (c + g) * 0.5, clamp(amount * 0.8, 0.0, 0.6)), 1.0);\n"
"}\n"
msgstr ""

