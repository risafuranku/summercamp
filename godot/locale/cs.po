msgid "Cooler"
msgstr "Chladič"

#: scripts/pub/pub_layout.gd:261
msgid "The python: ice water round the beer line. It hums loudest when nobody is pouring."
msgstr "Python: ledová voda kolem pivního vedení. Nejvíc hučí, když nikdo netočí."

#: scripts/pub/pub_layout.gd:264
msgid "oak barrel"
msgstr "dubový sud"

#: scripts/pub/pub_layout.gd:264
msgid "Oak, chalked 1968. Nobody has delivered oak for thirty years. It is full, and cold, and it is not on the books."
msgstr "Dub, křídou 1968. Dubové sudy nikdo nevozí třicet let. Je plný, studený a v knížce není."

#: scripts/pub/pub_layout.gd:265
msgid "Slops"
msgstr "Kbelík"

#: scripts/pub/pub_layout.gd:266
msgid "The slops bucket. Always half full, however often it is emptied."
msgstr "Kbelík na slitiny. Pořád do půlky plný, ať se vylévá jak chce často."

