#: scripts/town/pockets.gd:232
msgid "No cigarettes. The Jednota in Liblice has Start."
msgstr "Žádné cigarety. V Jednotě v Liblicích mají Start."

#: scripts/town/pockets.gd:240
msgid "No beer. The Jednota in Liblice has Lesnak."
msgstr "Žádné pivo. V Jednotě v Liblicích mají Lesňák."

#: scripts/town/pockets.gd:430
msgid "The wind takes the flame."
msgstr "Vítr sfoukne plamen."

#: scripts/town/pockets.gd:467
msgid "The rain has put it out. C lights it again."
