#: scripts/lake/logbook_closeup.gd:15
msgid ""
"LAKE BOOK\n"
"Cerne jezero\n"
"reservoir & sluice\n"
"\n"
"P. Hruby, keeper\n"
"from 1979"
msgstr ""
"KNIHA JEZERA\n"
"Černé jezero\n"
"nádrž a stavidlo\n"
"\n"
"P. Hrubý, hlídač\n"
"od 1979"

#: scripts/lake/logbook_closeup.gd:15
msgid ""
"12.4.\n"
"level 4.10\n"
"sluice shut. ice gone\n"
"from the bay.\n"
"\n"
"30.4.\n"
"level 4.22\n"
"oiled the gate.\n"
"boats out of the shed"
msgstr ""
"12.4.\n"
"hladina 4,10\n"
"stavidlo zavřeno.\n"
"ze zátoky led pryč.\n"
"\n"
"30.4.\n"
"hladina 4,22\n"
"namazal stavidlo.\n"
"lodě ven z kůlny"

#: scripts/lake/logbook_closeup.gd:16
msgid ""
"19.6.\n"
"level 4.30\n"
"camp open. Karel's\n"
"kids on the jetty\n"
"again. told them.\n"
"\n"
"2.7.\n"
"level 4.31\n"
"someone moved the\n"
"boat in the night.\n"
"rope cut clean."
msgstr ""
"19.6.\n"
"hladina 4,30\n"
"kemp otevřen. Karlovy\n"
"děti zase na molu.\n"
"řekl jsem jim to.\n"
"\n"
"2.7.\n"
"hladina 4,31\n"
"někdo v noci\n"
"přesunul loďku.\n"
"lano čistě uříznuté."

#: scripts/lake/logbook_closeup.gd:16
msgid ""
"14.8.87\n"
"the girl. we went\n"
"along the shore with\n"
"lamps till four.\n"
"nothing.\n"
"\n"
"the water stood\n"
"very still all night\n"
"like it was holding\n"
"its breath."
msgstr ""
"14.8.87\n"
"ta holka. chodili\n"
"jsme s lampami podél\n"
"břehu do čtyř.\n"
"nic.\n"
"\n"
"voda stála celou\n"
"noc úplně klidná,\n"
"jako by zadržovala\n"
"dech."

#: scripts/lake/logbook_closeup.gd:17
msgid ""
"3.5.93\n"
"level 4.05\n"
"the water board is\n"
"putting new pipes\n"
"under the camp.\n"
"the old ones are\n"
"full of what the\n"
"lake gave back."
msgstr ""
"3.5.93\n"
"hladina 4,05\n"
"vodárny dávají\n"
"pod kemp nové\n"
"trubky. ty staré\n"
"jsou plné toho,\n"
"co jezero vrátilo."

#: scripts/lake/logbook_closeup.gd:17
msgid ""
"21.5.93\n"
"they knock. inside\n"
"the old pipes, from\n"
"far along. three\n"
"times. the workmen\n"
"laugh. I knocked\n"
"back once. I should\n"
"not have."
msgstr ""
"21.5.93\n"
"klepe to. ve starých\n"
"trubkách, zdaleka.\n"
"třikrát. dělníci\n"
"se smějou. jednou\n"
"jsem zaklepal zpátky.\n"
"neměl jsem."

#: scripts/lake/logbook_closeup.gd:18
msgid ""
"1.6.93\n"
"it answers the\n"
"hammer now. it\n"
"comes to the noise.\n"
"keep the lamp on it\n"
"and it goes.\n"
"\n"
"it cannot see.\n"
"I am almost sure."
msgstr ""
"1.6.93\n"
"už odpovídá na\n"
"kladivo. jde za\n"
"hlukem. drž na něm\n"
"lampu a odejde.\n"
"\n"
"nevidí.\n"
"jsem si skoro jistý."

#: scripts/lake/logbook_closeup.gd:18
msgid ""
"2.6.93\n"
"they are pulling\n"
"the last old pipe\n"
"tomorrow. I said I\n"
"would go down with\n"
"them and look.\n"
"\n"
"if it knocks three\n"
"times it is not\n"
"the water."
msgstr ""
"2.6.93\n"
"zítra tahají\n"
"poslední starou\n"
"trubku. řekl jsem,\n"
"že půjdu dolů\n"
"s nimi a podívám se.\n"
"\n"
"když zaklepe\n"
"třikrát, není to\n"
"voda."

#: scripts/lake/logbook_closeup.gd:19
msgid ""
"\n"
"\n"
"\n"
"\n"
"     (nothing after\n"
"      this. the rest\n"
"      of the pages\n"
"      are swollen\n"
"      with damp.)"
msgstr ""
"\n"
"\n"
"\n"
"\n"
"     (dál už nic.\n"
"      ostatní stránky\n"
"      jsou nabobtnalé\n"
"      vlhkem.)"

