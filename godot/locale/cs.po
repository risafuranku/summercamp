#: scripts/town/pub_closeup.gd:24 scripts/town/town_people.gd:56 scripts/town/town_room.gd:56
#. uses 3
msgid "Kitchen's shut. The cellar is not open to guests."
msgstr "Kuchyně je zavřená. Do sklepa hosti nesmí."

#: scripts/town/pub_closeup.gd:25 scripts/town/town_people.gd:57 scripts/town/town_room.gd:57
#. uses 3
msgid "Karbanatky to our own recipe. What is in them is the recipe."
msgstr "Karbanátky podle vlastní receptury. Co je v nich, to je ta receptura."

#: scripts/town/pub_closeup.gd:26 scripts/town/town_people.gd:58 scripts/town/town_room.gd:58
#. uses 3
msgid "If you have meat to sell, regular, any quantity, come round the back."
msgstr "Jestli máš maso na prodej, pravidelně, jakýkoli množství, přijď zezadu."

#: scripts/town/pub_closeup.gd:27 scripts/town/town_room.gd:59
#. uses 2
msgid "Your Vera sat where you are standing. Every Friday. Then one Friday she didn't, and she had not missed one in eleven years."
msgstr "Ta vaše Věra sedávala tam, kde stojíš. Každej pátek. Pak jeden pátek nepřišla, a za jedenáct let nevynechala ani jeden."

#: scripts/town/pub_closeup.gd:28 scripts/town/town_room.gd:60
#. uses 2
msgid "The machine pays. Not often. Like everything here."
msgstr "Automat vyplácí. Ne často. Jako všechno tady."

#: scripts/town/pub_closeup.gd:63 scripts/town/pub_closeup.gd:89 scripts/town/pub_closeup.gd:92 scripts/town/pub_closeup.gd:95 (+8)
#. uses 12
msgid "Mr Kubat"
msgstr "Pan Kubát"

#: scripts/town/pub_closeup.gd:63 scripts/town/town_room.gd:225
#. uses 2
msgid "Sit where you like. Beer's a dollar."
msgstr "Sedni si, kam chceš. Pivo za deset."

#: scripts/town/pub_closeup.gd:72
msgid "LUCKY 7. Somebody has scratched the 7 off the glass and drawn it back on in pen."
msgstr "LUCKY 7. Někdo tu sedmičku ze skla seškrábal a pak ji tam propiskou zase dokreslil."

#: scripts/town/pub_closeup.gd:92 scripts/town/town_room.gd:459
#. uses 2
msgid "Finish that one first."
msgstr "Nejdřív dopij tohle."

#: scripts/town/pub_closeup.gd:95 scripts/town/town_room.gd:462
#. uses 2
msgid "A dollar. I do not run a tab for the camp. Not any more."
msgstr "Deset korun. Kempu na dluh nenalejvám. Už ne."

#: scripts/town/pub_closeup.gd:121 scripts/town/town_room.gd:536
#. uses 2
msgid "The machine wants a dollar."
msgstr "Automat chce desetikorunu."

#: scripts/town/pub_closeup.gd:159
msgid "The machine rattles out %d dollar%s."
msgstr "Automat vychrlí %d0 korun{|||%s}."

#: scripts/town/pub_closeup.gd:161
msgid "Nothing. The lamps go round anyway."
msgstr "Nic. Světýlka se stejně točí dál."

#: scripts/town/pub_closeup.gd:217
msgid "LUCKY  7"
msgstr "LUCKY  7"

#: scripts/town/pub_closeup.gd:254
msgid "$1  START"
msgstr "$1  START"

#: scripts/town/pub_closeup.gd:258
msgid "WIN %d"
msgstr "VÝHRA %d0"

#: scripts/town/pub_closeup.gd:268
msgid "BAR"
msgstr "BAR"

#: scripts/town/pump_closeup.gd:25
msgid "Natural"
msgstr "Natural"

#: scripts/town/pump_closeup.gd:25
msgid "Special"
msgstr "Special"

#: scripts/town/pump_closeup.gd:65
msgid "%s. %d dollars' worth, please."
msgstr "%s. Za %d0 korun, prosím."

#: scripts/town/pump_closeup.gd:67
msgid "%s, %d litres. Not a drop more, I measure it at home."
msgstr "%s, %d {litr|litry|litrů}. Ani kapku navíc, doma si to přeměřím."

#: scripts/town/pump_closeup.gd:68
msgid "Fill her up. %s."
msgstr "Plnou, prosím. %s."

#: scripts/town/pump_closeup.gd:133
msgid "%s? In my car? You wait till Lojza hears about this."
msgstr "%s? Do mýho auta? Počkej, až se to dozví Lojza."

#: scripts/town/pump_closeup.gd:152
msgid "Right on it. Here, for you."
msgstr "Přesně na chlup. Tady, to je pro tebe."

#: scripts/town/pump_closeup.gd:152
msgid "Full to the neck. Good lad."
msgstr "Plná až po hrdlo. {g:Hodnej kluk|Hodná holka}."

#: scripts/town/pump_closeup.gd:155
msgid "Near enough."
msgstr "Ujde to."

#: scripts/town/pump_closeup.gd:157
msgid "That's not what I asked for. Here, take it, I'm late."
msgstr "Tohle není ono. Tady, vem si to, spěchám."

#: scripts/town/pump_closeup.gd:160
msgid "I said %s. I'm not paying for your extra."
msgstr "Domluva byla jiná{|||%s}. Za to navíc platit nebudu."

#: scripts/town/pump_closeup.gd:160
msgid "%d dollars"
msgstr "%d0 korun"

#: scripts/town/pump_closeup.gd:160
msgid "%d litres"
msgstr "%d {litr|litry|litrů}"

#: scripts/town/pump_job.gd:18
msgid "Mr Dvorak"
msgstr "Pan Dvořák"

#: scripts/town/pump_job.gd:18
msgid "A woman in a fur hat"
msgstr "Paní v kožešinové čepici"

#: scripts/town/pump_job.gd:18
msgid "A man in a suit"
msgstr "Pán v obleku"

#: scripts/town/pump_job.gd:18
msgid "A farmer"
msgstr "Sedlák"

#: scripts/town/pump_job.gd:18
msgid "A young man"
msgstr "Mladík"

#: scripts/town/pump_job.gd:18
msgid "Mrs Kopecka"
msgstr "Paní Kopecká"

#: scripts/town/pump_job.gd:18
msgid "A priest"
msgstr "Farář"

#: scripts/town/pump_job.gd:62
msgid "That's you done. %d dollars today."
msgstr "Tak, hotovo. Dneska %d0 korun."

#: scripts/town/pump_job.gd:62
msgid "Done already? You didn't earn your boots."
msgstr "Už končíš? Ani sis {g:nevydělal|nevydělala} na boty."

#: scripts/town/punch_closeup.gd:36
msgid "The orange box. Your ticket in your hand: put it in the slot."
msgstr "Oranžový štípač. Jízdenka v ruce: zasuň ji do štěrbiny."

#: scripts/town/punch_closeup.gd:72
msgid "Cvak."
msgstr "Cvak."

#: scripts/town/punch_closeup.gd:81
msgid "Punched: the holes through it, %s printed along the edge. Click it to put it away."
msgstr "Označeno: proděravěná, po okraji natištěno %s. Kliknutím ji schováš."

#: scripts/town/punch_closeup.gd:125
msgid "JÍZDENKA"
msgstr "JÍZDENKA"

#: scripts/town/punch_closeup.gd:126
msgid "NEPŘESTUPNÍ"
msgstr "NEPŘESTUPNÍ"

#: scripts/town/road_south.gd:43
msgid "CERNE JEZERO, KEMP"
msgstr "ČERNÉ JEZERO, KEMP"

#: scripts/town/ruin_closeup.gd:52
msgid "The Hronek kitchen. No roof over the back of it. Somebody has laid the table."
msgstr "Kuchyně u Hronků. Vzadu nad ní není střecha. Někdo prostřel stůl."

#: scripts/town/ruin_closeup.gd:54
msgid "The Hronek kitchen. The chair is turned to face the door now. To face you."
msgstr "Kuchyně u Hronků. Židle je teď otočená ke dveřím. K tobě."

#: scripts/town/ruin_closeup.gd:66
msgid "One plate, clean. The fork beside it, the way you lay it for a child. The dust is on everything but the plate."
msgstr "Jeden talíř, čistý. Vedle vidlička, jak se prostírá dítěti. Prach je na všem kromě talíře."

#: scripts/town/ruin_closeup.gd:69
msgid "The chair is turned to face the wall, as if somebody sat there being punished. Or waiting."
msgstr "Židle je otočená ke zdi, jako by tam někdo seděl za trest. Nebo čekal."

#: scripts/town/ruin_closeup.gd:71
msgid "The chair faces the door. You did not move it."
msgstr "Židle je otočená ke dveřím. {g:Nehýbal|Nehýbala} jsi s ní."

#: scripts/town/ruin_closeup.gd:73
msgid "A Jednota calendar, 1984. August. The days crossed out up to the fourteenth in a child's hand. After that, nothing."
msgstr "Kalendář Jednoty, 1984. Srpen. Dny přeškrtané do čtrnáctého, dětskou rukou. Potom nic."

#: scripts/town/ruin_closeup.gd:75
msgid "Cold. But it smells of wet ash, fresh."
msgstr "Studeno. Ale je cítit mokrý popel, čerstvý."

#: scripts/town/ruin_closeup.gd:78
msgid "Nothing there now. The floor in the doorway is wet, and there is lake weed on the threshold."
msgstr "Teď tam nic není. Podlaha ve dveřích je mokrá a na prahu leží řasa z jezera."

#: scripts/town/ruin_closeup.gd:80
msgid "The back room. Too dark to see into. It goes on further than the house does."
msgstr "Zadní světnice. Moc tma, nic nevidíš. Táhne se dál, než sahá dům."

#: scripts/town/ruin_closeup.gd:91
msgid "Something stood in the back doorway. Small. Wet. Then it did not."
msgstr "V zadních dveřích něco stálo. Malé. Mokré. A pak už ne."

#: scripts/town/shop_closeup.gd:20 scripts/town/town_room.gd:43
#. uses 2
msgid "Start. Twenty. Two dollars."
msgstr "Start, dvacet kusů. Dvacet korun."

#: scripts/town/shop_closeup.gd:21 scripts/town/town_room.gd:44
#. uses 2
msgid "Lesnak. Bring the bottle back next time."
msgstr "Lesňák. Příště vrať láhev."

#: scripts/town/shop_closeup.gd:22
msgid "Rychla kacka. Scratch it here, not on my counter."
msgstr "Rychlá kačka. Stírej ji tady, ne o můj pult."

#: scripts/town/shop_closeup.gd:23 scripts/town/town_room.gd:46
#. uses 2
msgid "Batteries are sold out until further notice. Please stop asking."
msgstr "Baterie jsou do odvolání vyprodané. Už se prosím neptej."

#: scripts/town/shop_closeup.gd:28 scripts/town/shop_closeup.gd:67 scripts/town/town_room.gd:49 scripts/town/town_room.gd:223
#. uses 4
msgid "What will it be."
msgstr "Co to bude."

#: scripts/town/shop_closeup.gd:29 scripts/town/town_room.gd:50
#. uses 2
msgid "My husband does your lamps up there. He says your main is older than he is."
msgstr "Můj muž vám tam nahoře dělá lampy. Prý máte hlavní jistič starší než on."

#: scripts/town/shop_closeup.gd:30 scripts/town/town_room.gd:51
#. uses 2
msgid "Your Vera bought candles. Boxes of them, that last summer. And chalk."
msgstr "Ta vaše Věra kupovala svíčky. Celé krabice, to poslední léto. A křídu."

#: scripts/town/shop_closeup.gd:31 scripts/town/town_room.gd:52
#. uses 2
msgid "Bread comes Tuesdays and Fridays. Same as the van to your gate."
msgstr "Chleba vozí v úterý a v pátek. Stejně jako dodávka k vaší bráně."

#: scripts/town/shop_closeup.gd:32 scripts/town/town_room.gd:53
#. uses 2
msgid "We shut at five. After five I do not open for anybody."
msgstr "Zavíráme v pět. Po páté neotevřu nikomu."

#: scripts/town/shop_closeup.gd:67 scripts/town/shop_closeup.gd:97 scripts/town/shop_closeup.gd:102 scripts/town/shop_closeup.gd:105 (+9)
#. uses 13
msgid "Mrs Novotna"
msgstr "Paní Novotná"

#: scripts/town/shop_closeup.gd:76
msgid "Silver over six fields. A coin would be better than a fingernail."
msgstr "Šest políček stříbra. Mince by byla lepší než nehet."

#: scripts/town/shop_closeup.gd:105 scripts/town/town_room.gd:443
#. uses 2
msgid "That's %d dollars. You have not got %d dollars."
msgstr "To je %d0 korun. %d0 korun nemáš."

#: scripts/town/shop_closeup.gd:214
msgid "Three %s. Well. %d dollars. Do not tell anybody where you bought it."
msgstr "Tři stejný{|||%s}. No teda. %d0 korun. Nikomu neříkej, kdes to {g:koupil|koupila}."

#: scripts/town/shop_closeup.gd:216
msgid "Nothing. Nobody wins. My husband says they print them that way."
msgstr "Nic. Nikdo nevyhrává. Muž říká, že je tak tisknou."

#: scripts/town/shop_closeup.gd:286
msgid "RYCHLA KACKA"
msgstr "RYCHLÁ KAČKA"

#: scripts/town/shop_closeup.gd:287
msgid "3 alike win.   $1"
msgstr "3 stejné vyhrávají.   $1"

