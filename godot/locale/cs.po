msgstr "x - na znamení"

#: scripts/town/timetable_closeup.gd:64
msgid "Jízdenku z automatu"
msgstr "Jízdenku z automatu"

#: scripts/town/timetable_closeup.gd:64
msgid "označte po nástupu."
msgstr "označte po nástupu."

#: scripts/town/timetable_closeup.gd:64
