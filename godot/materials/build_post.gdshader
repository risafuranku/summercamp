shader_type canvas_item;

// Build-engine style palette post-process.
//
// The 3D view is rendered into a low-resolution SubViewport (see retro_render.gd) and
// upscaled with nearest filtering. This shader forces every pixel through a 256-colour
// palette made of shade ramps (generated by tools/gen_palette_lut.py from the game's own
// Redneck Rampage textures), with a light ordered dither in low-res pixel space so
// gradients break up the way 8-bit renderers did.

uniform sampler2D palette_lut : filter_nearest, repeat_disable;
uniform float lut_size = 32.0;
uniform float palette_mix : hint_range(0.0, 1.0) = 1.0;
uniform float dither_strength : hint_range(0.0, 2.0) = 0.85;
uniform float contrast : hint_range(0.5, 1.5) = 1.06;
uniform float brightness : hint_range(-0.2, 0.2) = 0.0;

const float BAYER4[16] = float[](
	0.0, 8.0, 2.0, 10.0,
	12.0, 4.0, 14.0, 6.0,
	3.0, 11.0, 1.0, 9.0,
	15.0, 7.0, 13.0, 5.0
);

vec3 lut_lookup(vec3 c) {
	float n = lut_size - 1.0;
	vec3 q = floor(clamp(c, 0.0, 1.0) * n + 0.5);
	vec2 uv = vec2((q.b * lut_size + q.r + 0.5) / (lut_size * lut_size), (q.g + 0.5) / lut_size);
	return texture(palette_lut, uv).rgb;
}

void fragment() {
	vec4 raw = texture(TEXTURE, UV);
	vec3 c = (raw.rgb - 0.5) * contrast + 0.5 + brightness;
	ivec2 px = ivec2(floor(UV / TEXTURE_PIXEL_SIZE));
	float bayer = BAYER4[(px.x & 3) + (px.y & 3) * 4] / 16.0 - 0.47;
	vec3 dithered = c + vec3(bayer * dither_strength / (lut_size - 1.0));
	vec3 pal = lut_lookup(dithered);
	COLOR = vec4(mix(clamp(c, 0.0, 1.0), pal, palette_mix), raw.a);
}
